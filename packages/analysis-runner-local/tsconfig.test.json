{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@arch-atlas/llm-importer": ["../../apps/llm-importer/src/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*", "eval/**/*"],
  "exclude": ["eval/golden/*/workspace/**/*"]
}
