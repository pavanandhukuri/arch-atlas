{
  "name": "@arch-atlas/llm-importer",
  "version": "0.1.0",
  "description": "Deterministic, model-free multi-repository architecture importer for arch-atlas",
  "keywords": [
    "architecture",
    "c4",
    "diagram",
    "monorepo",
    "static-analysis",
    "arch-atlas"
  ],
  "license": "MIT",
  "homepage": "https://github.com/pavanandhukuri/arch-atlas/tree/main/apps/llm-importer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/pavanandhukuri/arch-atlas.git",
    "directory": "apps/llm-importer"
  },
  "type": "module",
  "bin": {
    "arch-atlas-import": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run clean && pnpm run build",
    "import": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@arch-atlas/core-model": "workspace:*",
    "@arch-atlas/layout": "workspace:*",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.6.1",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
