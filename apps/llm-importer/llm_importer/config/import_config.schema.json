{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arch-atlas.local/schemas/import-config.schema.json",
  "title": "Arch Atlas LLM Import Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "provider", "output", "repositories"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "provider": {
      "$ref": "#/$defs/ProviderConfig"
    },
    "output": {
      "$ref": "#/$defs/OutputConfig"
    },
    "analysis": {
      "$ref": "#/$defs/AnalysisConfig"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/RepositoryEntry" }
    },
    "systems": {
      "type": "array",
      "items": { "$ref": "#/$defs/SystemGroup" }
    }
  },
  "$defs": {
    "ProviderConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["anthropic", "ollama", "openai", "mlx"] },
        "model": { "type": "string" },
        "endpoint": { "type": "string" },
        "apiKeyEnvVar": { "type": "string" },
        "apiKey": { "type": "string" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "OutputConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "diagramFileName": { "type": "string", "minLength": 1 }
      }
    },
    "AnalysisConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFilesPerRepo": { "type": "integer", "minimum": 10, "maximum": 1000 },
        "excludePatterns": { "type": "array", "items": { "type": "string" } },
        "forceRefresh": { "type": "boolean" },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "RepositoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "SystemGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repositories": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
