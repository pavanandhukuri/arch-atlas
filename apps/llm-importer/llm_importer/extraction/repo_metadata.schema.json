{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-metadata",
  "title": "RepositoryMetadata",
  "type": "object",
  "required": [
    "schemaVersion",
    "analyzedAt",
    "repository",
    "connections",
    "confidence",
    "filesSampled",
    "filesTotal"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "analyzedAt": { "type": "string" },
    "repository": {
      "type": "object",
      "required": ["name", "path"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "targetService", "targetAddresses", "confidence", "evidence"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["http", "database", "kafka", "queue", "grpc", "unknown"]
          },
          "targetService": { "type": "string", "minLength": 1 },
          "targetAddresses": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "topics": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "extractionMethod": { "type": "string" },
    "filesSampled": { "type": "integer", "minimum": 0 },
    "filesTotal": { "type": "integer", "minimum": 0 }
  }
}
