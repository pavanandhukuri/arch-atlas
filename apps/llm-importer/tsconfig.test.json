{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@arch-atlas/llm-importer": ["./src/index.ts"],
      "@arch-atlas/analysis-runner-local": ["../../packages/analysis-runner-local/src/index.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "vendor/**/*",
    "test/fixtures/repos/**/*",
    "test/eval/golden/*/workspace/**/*"
  ]
}
