.cursor

# Local Claude Code config — personal to whoever is developing this repo, not shipped.
# The repo-analysis producer moved to plugins/repo-analysis/ (a tracked, first-class
# deliverable) — see that directory, not here.
.claude/*

# Node/TypeScript
node_modules/
dist/
build/
*.log
.env
.env.*
!.env.example
!.env.local.example

# Build outputs
.turbo/
.next/
.next-dev/
coverage/

# Editor artifacts
.DS_Store
Thumbs.db
*.swp
*.tmp
.vscode/
.idea/
# eval — externally cloned golden workspaces (pinned by SHA in eval.config.yaml)
apps/llm-importer/eval/golden/*/workspace/

# examples — generated by running the importer, not committed
examples/*/architecture-output/architecture.review.yaml
examples/*/architecture-output/*.context.json
# 015: *.components.json is now a committed demo artifact like *.analysis.json —
# component analysis is default, not an exploratory opt-in run (reverses 014's
# original non-goal here).

# TypeScript incremental build cache — regenerated by every typecheck
*.tsbuildinfo
